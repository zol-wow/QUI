* text=auto eol=lf

*.png binary
*.tga binary
*.ttf binary
*.TTF binary

# Generated output: collapsed in GitHub diffs and excluded from language stats.
# A regen touches millions of lines across these files, which buries the
# hand-written part of a PR. Every entry in this section carries a "GENERATED
# by ... do not edit by hand" header.
#
# Comments must be on their own line — git parses a trailing "# ..." as another
# attribute name and rejects the whole line ("# is not a valid attribute name"),
# silently leaving the path unmarked.
#
# Deliberately NOT marked `-diff`: the staleness gates in tools/test.sh and
# .github/workflows/lua-tests.yml print `git diff` of these paths to show what
# went stale, and `-diff` would reduce that to "Binary files differ".

# enUS base from tools/i18n/extract_strings.lua; the ten translation overlays
# from tools/i18n/translate_delta.py. The locale-shaped pattern leaves
# hand-written core/locale/locale.lua alone.
core/locale/[a-z][a-z][A-Z][A-Z].lua linguist-generated=true

# tools/generate_search_cache.lua
*/search_cache.lua linguist-generated=true

# tools/generate_event_allowlist.lua
QUI_Debug/event_allowlist.lua linguist-generated=true

# tools/gen_new_profile_seed.lua
importstrings/starter_profile.lua linguist-generated=true

# lua tools/test_taint.lua --update-index
tests/api-docs/api-index.lua linguist-generated=true

tests/helpers/global_assignment_inventory.lua linguist-generated=true

# meta/ is generated by tools/generate_lua_definitions.lua — EXCEPT meta/ace.lua,
# which is hand-written and would never be recreated by a regen. List the
# generated two explicitly rather than globbing meta/, so ace.lua keeps showing
# up in diffs like the source it is.
meta/wow-api.lua linguist-generated=true
meta/wow-widgets.lua linguist-generated=true

# Not generated, but noise in PR diff review all the same: vendored libraries,
# repo tooling, and media. linguist-generated is what collapses a file in the
# GitHub diff view (linguist-vendored alone only affects language stats), so
# these borrow it deliberately; libs/ is additionally marked vendored.
libs/** linguist-vendored linguist-generated=true
tools/** linguist-generated=true
assets/** linguist-generated=true
