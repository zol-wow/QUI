{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime.version": "Lua 5.1",
    "workspace.library": [
        "meta"
    ],
    "workspace.ignoreDir": [
        ".vscode",
        "libs",
        "tools",
        "tests"
    ],
    "diagnostics.disable": [
        "cast-local-type",
        "duplicate-set-field",
        "inject-field",
        "need-check-nil",
        "redefined-local",
        "undefined-field",
        "unused-function",
        "unused-local",
        "unused-vararg"
    ],
    "diagnostics.globals": [
        "BigWigs",
        "BigWigsLoader",
        "DandersFrames_GetPinnedContainer",
        "DandersFrames_GetRaidContainer",
        "DandersFrames_IsReady",
        "GSE",
        "GSEOptions",
        "RaiderIO"
    ]
}
